#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelSub {
public:
    __aicore__ inline KernelSub(){}  

    //完成内存初始化操作
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {   
        //确定数据最终的实际处理长度
        this->blocklength = totalLength / AscendC::GetBlockNum(); //确定一级数据切分
        this->tileNum = tileNum; //确定核内二级数据切分
        this->tileLength = this->blocklength / this->tileNum / BUFFER_NUM ; //确定了每次实际上处理的数据长度

        //开始设计每一个核处理变量对应的 GlobalMemory 的起始地址
        xGm.SetGlobalBuffer( (__gm__ float *)x + this->blocklength * AscendC::GetBlockIdx(),this->blocklength);
        yGm.SetGlobalBuffer( (__gm__ float *)y + this->blocklength * AscendC::GetBlockIdx(),this->blocklength);
        zGm.SetGlobalBuffer( (__gm__ float *)z + AscendC::GetBlockIdx() * this->blocklength,this->blocklength);

        //分配内存
        pipe.InitBuffer(inQueueX , BUFFER_NUM , this->tileLength * sizeof( float ) );
        pipe.InitBuffer(inQueueY , BUFFER_NUM , this->tileLength * sizeof( float ) );
        pipe.InitBuffer(outQueueZ , BUFFER_NUM ,this->tileLength * sizeof( float ) );

    }


    __aicore__ inline void Process()
    {
        //确定一次运算所需要的循环次数。  循环次数 = blcokdata被分成的tilenum数量 X BUFFER——NUM
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        //为了完成一次完整的计算，所进行的具体操作
        for(int32_t i = 0 ; i < loopCount ;i ++){ 
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    //执行CopyIn流程
    __aicore__ inline void CopyIn(int32_t progress)
    {
        //Step1： 分配LocalTensor 内存
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        //Step2: 开始Copy操作
        AscendC::DataCopy(xLocal, xGm[progress * this-> tileLength] , this-> tileLength);
        AscendC::DataCopy(yLocal , yGm[progress * this-> tileLength] , this->tileLength );

        //Step3:开始把数据从LocalMemery 放入通信队列
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    //执行Compute流程
    __aicore__ inline void Compute(int32_t progress)
    {
        // Step1:为变量分配内存空间，获取通信队列数据
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();

        //Step2:为输出结果分配内存空间
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        //Step3:执行相减操作
        AscendC::Sub(zLocal , xLocal , yLocal , this->tileLength);

        //Step4:将结果从本地内存传如通信队列
        outQueueZ.EnQue<float>(zLocal);

        //Step5:释放不用的内存：xLocal & yLocal
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // Step1:从队列中提取运算结果
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        //Step2：将结果拷贝至GlobalMemory中
        AscendC::DataCopy(zGm[progress*this->tileLength],zLocal,this->tileLength);

        //Step3：释放不用的内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 核心变量，代表某一内存空间的变量
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,BUFFER_NUM> inQueueX , inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT,BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    //切分变量，代表数据切分的变量
    uint32_t blocklength;
    uint32_t tileNum;
    uint32_t tileLength;
};

//这个函数负责聚焦核函数运算的核心过程
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    // Step1:实例化 减法算子类 得到一个对象
    KernelSub op;

    //Step2:初始化这个对象
    op.Init(x,y,z,tiling.totalLength,tiling.tileNum);

    //Step3：操作这个对象
    op.Process();

}

//这个函数负责在主机侧进行核函数从分配内存空间开始的全流程
std::vector<float> kernel_sub(std::vector<float> &x, std::vector<float> &y)
{
    // 1：全局准备
    constexpr uint32_t numBlocks = 8;
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    SubCustomTilingData tiling = {totalLength , 8}; // 确定数据切分方式

    //2、准备主机侧的输入数据指针
    uint8_t *xHost = reinterpret_cast<uint8_t *>( x.data() ); //data()作用是获取首指针 ；reinterpret_cast<uint8_t *> 作用是把右侧得到的指针类型强制转化为 uint8_t* 型
    uint8_t *yHost = reinterpret_cast<uint8_t *>( y.data() );

    //3、准备主机侧输出数据的指针
    uint8_t *zHost = nullptr;

    //4、准备数据在设备侧的指针
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    //5、初始化 AscensdCL ,这是最底层、直接作为程序与GPU接口的库
    aclInit(nullptr);

    //6、申请运行时资源
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    //7、申请内存空间
    aclrtMallocHost((void **)(&zHost), totalByteSize);          // 在Host侧为输出结果分配内存
    aclrtMalloc((void **)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    //8、数据搬运 ？
    aclrtMemcpy(xDevice , totalByteSize , xHost , totalByteSize , ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice , totalByteSize , yHost , totalByteSize , ACL_MEMCPY_HOST_TO_DEVICE);

    //9、正式调用核函数
    sub_custom <<<numBlocks , nullptr , stream>>>(xDevice , yDevice , zDevice , tiling);
    aclrtSynchronizeStream(stream);//确保当前Device所有操作都完成后，主机侧再进行下一步

    //10、结果回拷
    aclrtMemcpy(zHost , totalByteSize , zDevice , totalByteSize , ACL_MEMCPY_HOST_TO_DEVICE);
    //? 这个语句怎么理解
    std::vector<float> z ( (float *)zHost , (float *)(zHost + totalByteSize) );

    //11、释放内存
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    //? stream有什么用
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);

    //12、返回结果 并 去初始化
    aclFinalize();
    return z;


}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_sub(x,y);

    std::vector<float> golden(totalLength, valueX - valueY);
    return VerifyResult(output, golden);
}
